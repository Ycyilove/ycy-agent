{
  "mcpServers": {
    "fetch": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "connect_timeout": 15,
      "call_timeout": 60,
      "retries": 2
    },
    "tavily": {
      "transport": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "tavily-mcp"
      ],
      "env_from": {
        "TAVILY_API_KEY": "TAVILY_API_KEY"
      },
      "connect_timeout": 15,
      "call_timeout": 30,
      "retries": 2
    },
    "docgen": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-docgen"
      ],
      "transport": "stdio",
      "env": {
        "MCP_DOCGEN_OUTPUT_DIR": "D:\\Projects\\111\\LLM\\LLM",
        "MCP_DOCGEN_INPUT_DIR": "D:\\Projects\\111\\LLM\\LLM"
      }
    }
  }
}
